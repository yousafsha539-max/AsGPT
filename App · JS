/* ---- State ---- */
let activeChat = null;
let msgIdCounter = 200;
let typingTimeout = null;

/* ---- DOM References ---- */
const chatListEl   = $('chat-list');
const messagesEl   = $('messages');
const chatAreaEl   = $('chat-area');
const noChatEl     = $('no-chat');
const msgInput     = $('msgInput');
const headerAvatar = $('headerAvatar');
const headerName   = $('headerName');
const headerStatus = $('headerStatus');
const emojiPicker  = $('emoji-picker');
const searchInput  = $('searchInput');

/* =============================================
   RENDER CHAT LIST
   ============================================= */

function renderChatList(filter = '') {
  chatListEl.innerHTML = '';
  const filtered = filter
    ? chats.filter(c => c.name.toLowerCase().includes(filter.toLowerCase()))
    : chats;

  filtered.forEach(chat => {
    const item = document.createElement('div');
    item.className = 'chat-item' + (activeChat && activeChat.id === chat.id ? ' active' : '');
    item.setAttribute('data-id', chat.id);
    item.setAttribute('role', 'button');
    item.setAttribute('tabindex', '0');
    item.setAttribute('aria-label', chat.name);

    item.innerHTML = `
      <div class="chat-avatar" style="background:${chat.color}">
        ${chat.avatar}
        ${chat.online ? '<div class="online-dot" title="Online"></div>' : ''}
      </div>
      <div class="chat-info">
        <div class="chat-top">
          <span class="chat-name">${chat.name}</span>
          <span class="chat-time${chat.unread ? ' has-unread' : ''}">${chat.time}</span>
        </div>
        <div class="chat-bottom">
          <span class="chat-preview">${chat.lastMsg}</span>
          ${chat.unread > 0 ? `<span class="unread-badge">${chat.unread}</span>` : ''}
        </div>
      </div>`;

    item.addEventListener('click', () => openChat(chat.id));
    item.addEventListener('keydown', e => { if (e.key === 'Enter') openChat(chat.id); });
    chatListEl.appendChild(item);
  });
}

/* =============================================
   OPEN CHAT
   ============================================= */

function openChat(chatId) {
  const chat = chats.find(c => c.id === chatId);
  if (!chat) return;

  activeChat = chat;
  chat.unread = 0;

  /* Update header */
  headerAvatar.textContent = chat.avatar;
  headerAvatar.style.background = chat.color;
  headerName.textContent = chat.name;

  if (chat.online) {
    headerStatus.textContent = 'Online';
    headerStatus.className = 'header-status';
  } else {
    headerStatus.textContent = 'Akhri dafa kal dekha gaya';
    headerStatus.className = 'header-status offline';
  }

  /* Show chat area */
  noChatEl.style.display = 'none';
  chatAreaEl.classList.add('visible');

  renderMessages();
  renderChatList(searchInput.value);
  msgInput.focus();
}

/* =============================================
   RENDER MESSAGES
   ============================================= */

function renderMessages() {
  if (!activeChat) return;
  messagesEl.innerHTML = '';

  /* Date divider */
  const divider = document.createElement('div');
  divider.className = 'date-divider';
  divider.innerHTML = '<span>Aaj</span>';
  messagesEl.appendChild(divider);

  activeChat.messages.forEach(msg => {
    appendMessageBubble(msg, false);
  });

  scrollToBottom();
}

function appendMessageBubble(msg, animate = true) {
  const wrapper = document.createElement('div');
  wrapper.className = 'msg-wrapper ' + (msg.out ? 'out' : 'in');
  if (animate) wrapper.style.animation = 'msg-appear 0.18s ease-out';

  const ticksSVG = msg.out
    ? `<span class="msg-ticks ${msg.read ? '' : 'single'}">
        <svg viewBox="0 0 24 24"><path d="M0.41,13.41L6,19L7.41,17.58L1.83,12M22.24,5.58L11.66,16.17L7.5,12L6.07,13.41L11.66,19L23.66,7M18,7L16.59,5.58L10.24,11.93L11.66,13.34L18,7Z"/></svg>
       </span>`
    : '';

  wrapper.innerHTML = `
    <div class="msg-bubble">
      <div class="msg-text">${escapeHTML(msg.text)}</div>
      <div class="msg-meta">
        <span class="msg-time">${msg.time}</span>
        ${ticksSVG}
      </div>
    </div>`;

  messagesEl.appendChild(wrapper);
}

/* =============================================
   SEND MESSAGE
   ============================================= */

function sendMessage() {
  const text = msgInput.value.trim();
  if (!text || !activeChat) return;

  const msg = {
    id: ++msgIdCounter,
    text,
    out: true,
    time: getTime(),
    read: false,
  };

  activeChat.messages.push(msg);
  activeChat.lastMsg = text;
  activeChat.time = 'Abhi';
  msgInput.value = '';

  appendMessageBubble(msg, true);
  scrollToBottom();
  renderChatList(searchInput.value);

  /* Simulate reply */
  simulateReply();
}

function simulateReply() {
  /* Show typing indicator */
  const typingEl = document.createElement('div');
  typingEl.className = 'typing-wrapper';
  typingEl.id = 'typingIndicator';
  typingEl.innerHTML = `
    <div class="typing-bubble">
      <div class="typing-dot"></div>
      <div class="typing-dot"></div>
      <div class="typing-dot"></div>
    </div>`;
  messagesEl.appendChild(typingEl);
  scrollToBottom();

  const delay = 1200 + Math.random() * 1200;

  typingTimeout = setTimeout(() => {
    const indicator = $('typingIndicator');
    if (indicator) indicator.remove();

    const replyText = AUTO_REPLIES[Math.floor(Math.random() * AUTO_REPLIES.length)];
    const replyMsg = {
      id: ++msgIdCounter,
      text: replyText,
      out: false,
      time: getTime(),
      read: true,
    };

    if (activeChat) {
      activeChat.messages.push(replyMsg);
      activeChat.lastMsg = replyText;
      activeChat.time = 'Abhi';
      appendMessageBubble(replyMsg, true);
      scrollToBottom();
      renderChatList(searchInput.value);
    }
  }, delay);
}

/* =============================================
   EMOJI PICKER
   ============================================= */

function buildEmojiPicker() {
  emojiPicker.innerHTML = '';
  EMOJIS.forEach(emoji => {
    const btn = document.createElement('button');
    btn.className = 'emoji-btn-item';
    btn.textContent = emoji;
    btn.title = emoji;
    btn.addEventListener('click', e => {
      e.stopPropagation();
      msgInput.value += emoji;
      msgInput.focus();
      toggleEmojiPicker(false);
    });
    emojiPicker.appendChild(btn);
  });
}

function toggleEmojiPicker(forceClose = null) {
  const isHidden = emojiPicker.classList.contains('hidden');
  if (forceClose || !isHidden) {
    emojiPicker.classList.add('hidden');
  } else {
    emojiPicker.classList.remove('hidden');
    msgInput.focus();
  }
}

/* =============================================
   UTILITIES
   ============================================= */

function scrollToBottom() {
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

function escapeHTML(str) {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

/* =============================================
   EVENT LISTENERS
   ============================================= */

/* Send on Enter */
msgInput.addEventListener('keydown', e => {
  if (e.key === 'Enter' && !e.shiftKey) {
    e.preventDefault();
    sendMessage();
  }
});

/* Send Button */
$('sendBtn').addEventListener('click', sendMessage);

/* Emoji Button */
$('emojiBtn').addEventListener('click', e => {
  e.stopPropagation();
  if (!activeChat) return;
  toggleEmojiPicker();
});

/* Close emoji picker on outside click */
document.addEventListener('click', e => {
  if (!emojiPicker.contains(e.target) && e.target !== $('emojiBtn')) {
    toggleEmojiPicker(true);
  }
});

/* Search */
searchInput.addEventListener('input', e => {
  renderChatList(e.target.value);
});

/* Header call/video buttons (cosmetic) */
$('videoBtn').addEventListener('click', () => alert('📹 Video call feature jald آ raha hai!'));
$('callBtn').addEventListener('click', () => alert('📞 Voice call feature jald آ raha hai!'));

/* New Chat button (cosmetic) */
$('newChatBtn').addEventListener('click', () => alert('💬 Naya chat shuru karne ki feature jald آ raha hai!'));

/* =============================================
   INIT
   ============================================= */

function init() {
  buildEmojiPicker();
  renderChatList();
  openChat(1); /* Open first chat by default */
}

init();

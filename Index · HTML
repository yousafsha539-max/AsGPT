<!DOCTYPE html>
<html lang="ur" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WhatsApp Clone</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <div id="app">

    <!-- ===== SIDEBAR ===== -->
    <aside id="sidebar">

      <!-- Sidebar Header -->
      <div id="sidebar-header">
        <div class="my-avatar" id="myAvatar">A</div>
        <div class="sidebar-icons">
          <button class="icon-btn" title="Naya Chat" id="newChatBtn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"/></svg>
          </button>
          <button class="icon-btn" title="Menu" id="menuBtn">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
          </button>
        </div>
      </div>

      <!-- Search Bar -->
      <div id="search-bar">
        <div class="search-wrap">
          <svg class="search-icon" viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
          <input type="text" id="searchInput" placeholder="Chat dhundein ya shuru karein" autocomplete="off" />
        </div>
      </div>

      <!-- Chat List -->
      <div id="chat-list"></div>

    </aside>

    <!-- ===== MAIN PANEL ===== -->
    <main id="main">

      <!-- No Chat Selected -->
      <div id="no-chat">
        <div class="no-chat-icon">
          <svg viewBox="0 0 303 172" fill="none" xmlns="http://www.w3.org/2000/svg" width="220">
            <path d="M229.565 160.229C252.021 149.145 267.554 127.96 267.554 104.209C267.554 69.8284 235.788 41.9258 196.659 41.9258C157.53 41.9258 125.763 69.8284 125.763 104.209C125.763 138.59 157.53 166.492 196.659 166.492C207.608 166.492 217.968 164.237 227.215 160.229L229.565 160.229Z" fill="#EDEDED"/>
            <path d="M85.187 110.555C85.187 78.254 111.557 52.0479 143.876 52.0479C176.196 52.0479 202.566 78.254 202.566 110.555C202.566 142.856 176.196 168.963 143.876 168.963C134.231 168.963 125.123 166.641 117.089 162.499L85.187 170.379L93.222 139.47C88.265 130.551 85.187 120.385 85.187 110.555Z" fill="#FFFFFF" stroke="#DADDE1" stroke-width="1.5"/>
          </svg>
        </div>
        <h2>WhatsApp Web</h2>
        <p>Apne phone ke messages yahan dekhen</p>
        <span class="lock-notice">
          <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
          End-to-end encrypted
        </span>
      </div>

      <!-- Chat Area (hidden until chat selected) -->
      <div id="chat-area">

        <!-- Chat Header -->
        <div id="chat-header">
          <div class="chat-header-left">
            <div class="header-avatar" id="headerAvatar"></div>
            <div class="header-info">
              <div class="header-name" id="headerName"></div>
              <div class="header-status" id="headerStatus"></div>
            </div>
          </div>
          <div class="header-actions">
            <button class="hdr-btn" title="Video Call" id="videoBtn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
            </button>
            <button class="hdr-btn" title="Voice Call" id="callBtn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
            </button>
            <button class="hdr-btn" title="Search" id="searchChatBtn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
            </button>
            <button class="hdr-btn" title="More Options" id="moreChatBtn">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/></svg>
            </button>
          </div>
        </div>

        <!-- Messages Area -->
        <div id="messages" role="log" aria-live="polite"></div>

        <!-- Input Area -->
        <div id="input-area">
          <button class="input-icon-btn" id="emojiBtn" title="Emoji">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm3.5-9c.83 0 1.5-.67 1.5-1.5S16.33 8 15.5 8 14 8.67 14 9.5s.67 1.5 1.5 1.5zm-7 0c.83 0 1.5-.67 1.5-1.5S9.33 8 8.5 8 7 8.67 7 9.5 7.67 11 8.5 11zm3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5z"/></svg>
          </button>
          <button class="input-icon-btn" id="attachBtn" title="Attach">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 6v11.5c0 2.21-1.79 4-4 4s-4-1.79-4-4V5c0-1.38 1.12-2.5 2.5-2.5s2.5 1.12 2.5 2.5v10.5c0 .55-.45 1-1 1s-1-.45-1-1V6H10v9.5c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5V5c0-2.21-1.79-4-4-4S7 2.79 7 5v12.5c0 3.04 2.46 5.5 5.5 5.5s5.5-2.46 5.5-5.5V6h-1.5z"/></svg>
          </button>
          <div class="message-input-wrap">
            <input type="text" id="msgInput" placeholder="Paigham likhein" autocomplete="off" aria-label="Paigham" />
          </div>
          <button class="send-btn" id="sendBtn" title="Bhejein">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
          </button>
        </div>

      </div><!-- end #chat-area -->

      <!-- Emoji Picker -->
      <div id="emoji-picker" class="hidden"></div>

    </main><!-- end #main -->

  </div><!-- end #app -->

  <script src="app.js"></script>
</body>
</html>
